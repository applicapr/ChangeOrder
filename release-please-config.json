{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "package-name": "changeorder-api",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "xml",
          "path": "Directory.Build.props",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "xml",
          "path": "src/ChangeOrder.Domain/ChangeOrder.Domain.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "xml",
          "path": "src/ChangeOrder.Business/ChangeOrder.Business.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "xml",
          "path": "src/ChangeOrder.Data/ChangeOrder.Data.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "xml",
          "path": "src/ChangeOrder.Presentation/ChangeOrder.Presentation.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        },
        {
          "type": "xml",
          "path": "src/ChangeOrder.Host/ChangeOrder.Host.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true }
      ]
    }
  }
}
