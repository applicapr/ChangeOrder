<Project>

  <!--
    Repository-wide MSBuild defaults.
    Applies to every .csproj under this directory tree.
    See specs/001-change-order-management/plan.md (§Technical Context) and tasks.md T001.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!--
      Product version surfaced by `GET /version` (see openapi.yaml).
      Propagates to AssemblyVersion, AssemblyFileVersion and
      AssemblyInformationalVersion across every project in the solution.
    -->
    <Version>1.1.2</Version>

    <!--
      Silence CS1591 "Missing XML comment for publicly visible type or member"
      at the repo level. We still GenerateDocumentationFile=true so the .xml
      ships next to the assembly, but we don't want every internal helper to
      require an XML doc block to compile under TreatWarningsAsErrors=true.
      Real public API surface remains documented case-by-case.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
