<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain layer — the core of the Onion.
    Constitution P-I (NON-NEGOTIABLE): ZERO outward dependencies.
    No ProjectReferences. The single PackageReference to
    Microsoft.Extensions.DependencyInjection.Abstractions is the standard
    .NET convention to expose AddDomain(this IServiceCollection) and does
    NOT introduce infrastructure (no EF Core, no ASP.NET, no MediatR).
  -->

  <PropertyGroup>
    <RootNamespace>ChangeOrder.Domain</RootNamespace>
    <AssemblyName>ChangeOrder.Domain</AssemblyName>

    <!-- Version: bumped by release-please on each release.
         FileVersion: updated post-release with the build date (yyyy.M.d.0). -->
    <Version>1.0.0</Version>
    <FileVersion>2026.5.13.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
