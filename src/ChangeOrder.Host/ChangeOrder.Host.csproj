<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host — Composition Root. The only project that wires everything together.
    References Presentation and Data; Domain and Business come transitively.
    R-8 gotcha: Microsoft.AspNetCore.OpenApi's XML-comment source generator
    emits code that uses C# 12 interceptors. We must allowlist its namespace
    via <InterceptorsNamespaces> or the build fails with CS9137.
  -->

  <PropertyGroup>
    <RootNamespace>ChangeOrder.Host</RootNamespace>
    <AssemblyName>ChangeOrder.Host</AssemblyName>
    <UserSecretsId>changeorder-host-dev</UserSecretsId>

    <!--
      Phase-1 bootstrap: no Program.cs exists yet (T044 creates it).
      Microsoft.NET.Sdk.Web defaults to OutputType=Exe and would fail with
      CS5001 "Program does not contain a static 'Main' method". We compile
      Host as a Library at this stage; T044 removes this override when the
      real Program.cs lands.
    -->
    <OutputType>Library</OutputType>

    <!-- R-8: required for Microsoft.AspNetCore.OpenApi source-generated interceptors. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChangeOrder.Presentation\ChangeOrder.Presentation.csproj" />
    <ProjectReference Include="..\ChangeOrder.Data\ChangeOrder.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog stack -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Health checks (SQL Server) -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
  </ItemGroup>

</Project>
