<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host — Composition Root. The only project that wires everything together.
    References Presentation and Data; Domain and Business come transitively.
    R-8 gotcha: Microsoft.AspNetCore.OpenApi's XML-comment source generator
    emits code that uses C# 12 interceptors. We must allowlist its namespace
    via <InterceptorsNamespaces> or the build fails with CS9137.
  -->

  <PropertyGroup>
    <RootNamespace>ChangeOrder.Host</RootNamespace>
    <AssemblyName>ChangeOrder.Host</AssemblyName>
    <UserSecretsId>changeorder-host-dev</UserSecretsId>

    <!-- Version: bumped by release-please on each release.
         FileVersion: updated post-release with the build date (yyyy.M.d.0). -->
    <Version>1.1.0</Version>
    <FileVersion>2026.5.14.0</FileVersion>

    <!-- R-8: required for Microsoft.AspNetCore.OpenApi source-generated interceptors. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChangeOrder.Presentation\ChangeOrder.Presentation.csproj"/>
    <ProjectReference Include="..\ChangeOrder.Data\ChangeOrder.Data.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog stack -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>

    <!--
      Enrichers used by both Development and Production sinks (T087).
      `Environment` covers `EnvironmentName` and `MachineName`; the
      `WithCorrelationId` enricher reads/writes the standard
      `X-Correlation-Id` header so cross-service traces stay coherent.
    -->
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1"/>
    <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="3.0.1"/>
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0"/>
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0"/>

    <!-- Health checks (SQL Server) -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0"/>

    <!-- Scalar interactive OpenAPI UI (replaces Swashbuckle/Swagger UI) -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.6"/>

    <!-- EF Core Design — required so `dotnet ef migrations` can run against the Host as startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
