<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation layer — Minimal API endpoints, DTOs, mappers.
    Depends ONLY on Business (Onion P-I).
    NOTE: Microsoft.AspNetCore.OpenApi and Asp.Versioning.Http are framework-adjacent
    packages required by Minimal API endpoint declarations and IEndpointRouteBuilder
    extensions used here. They do NOT cause Presentation to depend on Host.
  -->

  <PropertyGroup>
    <RootNamespace>ChangeOrder.Presentation</RootNamespace>
    <AssemblyName>ChangeOrder.Presentation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChangeOrder.Business\ChangeOrder.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
  </ItemGroup>

</Project>
